<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogDetective - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
            .hero-section {
                background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                color: white;
                padding: 80px 0;
            }

            .feature-icon {
                font-size: 2.5rem;
                color: #0d6efd;
                margin-bottom: 1rem;
            }

            .tech-badge {
                background-color: #e2e8f0;
                color: #334155;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 6px 14px;
                border-radius: 20px;
                margin: 3px;
                display: inline-block;
            }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i>LogDetective
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-flex navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link" href="#architecture">Architecture</a></li>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-primary btn-sm px-3" asp-controller="Admin" asp-action="Dashboard">Analyst Dashboard</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-success btn-sm px-3" asp-controller="Worker" asp-action="Dashboard">Worker Telemetry</a>
                            </li>
                        }
                        <li class="nav-item ms-2">
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm px-3">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item ms-lg-3"><a class="btn btn-outline-light btn-sm px-3" asp-area="Identity" asp-page="/Account/Login">Log In</a></li>
                        <li class="nav-item ms-2"><a class="btn btn-primary btn-sm px-3" asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-4 mt-auto">
        <div class="container text-center">
            <p class="mb-1 small">&copy; 2026 LogDetective - All Rights Reserved</p>
            <p class="mb-0 text-muted small">Submitted by BSEF24A051</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
