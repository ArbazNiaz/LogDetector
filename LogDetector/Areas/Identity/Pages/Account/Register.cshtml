@page
@model RegisterModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogDetective - Register</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body { background-color: #f8fafc; display: flex; flex-direction: column; min-height: 100vh; }
        .signup-card { max-width: 520px; width: 100%; margin: auto; }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i>LogDetective
            </a>
            <div class="ms-auto">
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-sm">Log In</a>
            </div>
        </div>
    </nav>

    <div class="container my-auto py-5">
        <div class="card shadow-sm border-0 signup-card">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h4 class="fw-bold">Create Account</h4>
                    <p class="text-muted small">Register as an Administrator or Log Analysis Viewer</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FirstName" class="form-label small fw-semibold"></label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="Arbaz" />
                            <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.LastName" class="form-label small fw-semibold"></label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Niaz" />
                            <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label small fw-semibold"></label>
                        <input asp-for="Input.Email" class="form-control" placeholder="analyst@logdetective.local" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label small fw-semibold"></label>
                        <select asp-for="Input.Role" class="form-select">
                            <option value="Admin">Security Administrator (Full Access: Upload, Manage &amp; View)</option>
                            <option value="Viewer">Log Monitor / Viewer (Read-Only Analysis View)</option>
                        </select>
                        <span asp-validation-for="Input.Role" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Password" class="form-label small fw-semibold"></label>
                            <input asp-for="Input.Password" class="form-control" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ConfirmPassword" class="form-label small fw-semibold"></label>
                            <input asp-for="Input.ConfirmPassword" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-semibold mb-3">Complete Registration</button>
                </form>

                <div class="text-center border-top pt-3">
                    <span class="small text-muted">Already registered? <a asp-area="Identity" asp-page="/Account/Login" class="text-primary text-decoration-none fw-semibold">Sign in here</a></span>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white py-3 mt-auto text-center">
        <small class="text-muted">&copy; 2026 LogDetective - All Rights Reserved</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
